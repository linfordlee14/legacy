# Local environment (DEP-01, DEP-04). Non-secret values only (DEP-18).
# The database credentials below are the local docker-compose convention,
# not secrets; staging and production URLs live only in platform secret
# managers (DEP-19) and are inventoried in infra/SECRETS_REGISTER.md.
LEGACY_ENV=local
LEGACY_API_PORT=8000
LEGACY_DATABASE_URL=postgresql://legacy:legacy@localhost:5432/legacy_local
# OIDC resource-server settings (non-secret; AUTHENTICATION 4.1). Unset means
# authenticated endpoints answer 503 auth_not_configured until the provider
# exists. Set to the dev Supabase project values once provisioned:
# LEGACY_OIDC_ISSUER=
# LEGACY_OIDC_AUDIENCE=
NEXT_PUBLIC_LEGACY_ENV=local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
