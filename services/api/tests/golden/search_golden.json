    },
    {
      "query": "deny by default privacy tier ceiling grants",
      "expect_any": ["security/AUTHORIZATION.md"]
    },
    {
      "query": "pgvector embedding chunk model version",
      "expect_any": ["database/DATABASE_SCHEMA.md", "ai/AI_ARCHITECTURE.md"]
    },
    {
      "query": "verification queue flagged claims evidence",
      "expect_any": ["knowledge/MASTER_CONTEXT.md", "security/PRIVACY.md"]
